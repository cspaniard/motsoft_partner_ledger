<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_partner_ledger_wizard" model="ir.ui.view">
        <field name="name">Libro Mayor Empresa</field>
        <field name="model">motsoft.partner.ledger</field>
        <field name="arch" type="xml">
            <form string="Libro Mayor Empresa">
                <group>
                    <field name="date_start" required="True"/>
                    <field name="date_end" required="True"/>
                </group>

                <group>
                    <group>
                        <field name="account_filter"/>
                    </group>
                    <group>
                        <button name="search_accounts" type="object" string="Buscar"
                                class="btn-primary" icon="fa-search"/>
                    </group>
                </group>

                <group>
                    <field name="tax_box"/>
                    <field name="account_ids" widget="many2many_tags"/>

                    <label string="" for="clear_accounts"/>
                    <button name="clear_accounts" type="object" string="Eliminar Cuentas"
                            class="btn-secondary" icon="fa-trash"/>
                </group>

                <footer>
                    <button string="Aceptar" type="object" name="action_print" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_ledger_menu" model="ir.actions.act_window">
        <field name="name">Libro Mayor Empresa con Saldo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">motsoft.partner.ledger</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_partner_ledger_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_partner_ledger"
              name="Mayor Empresa con Saldo"
              sequence="5"
              parent="accounting_pdf_reports.menu_finance_partner_reports"
              action="action_partner_ledger_menu"
              groups="account.group_account_invoice"/>

</odoo>
