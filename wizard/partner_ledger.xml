<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="report_partner_ledger_wizard" model="ir.ui.view">
        <field name="name">Libro Mayor Empresa</field>
        <field name="model">motsoft.partner.ledger</field>
        <field name="arch" type="xml">
            <form string="Libro Mayor Empresa">
                <group>
                    <field name="date_start" string="Fecha Inicio:"/>
                    <field name="date_end" string="Fecha Final:"/>
                </group>
                <group>
                    <field name="account_ids"
                           widget="many2many_tags"
                           string="Cuentas Contables:"/>
                </group>
                <footer>
                    <button string="Aceptar" type="object" name="action_print" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_partner_ledger_menu" model="ir.actions.act_window">
        <field name="name">Libro Mayor Empresa</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">motsoft.partner.ledger</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_partner_ledger_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_partner_ledger"
              name="Libro Mayor Empresa"
              sequence="5"
              parent="accounting_pdf_reports.menu_finance_partner_reports"
              action="action_partner_ledger_menu"
              groups="account.group_account_invoice"/>

</odoo>
