<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>

        <template id="partner_ledger_header">
            <div class="header">
                <div class='col-12' style="font-size:1.5em; font-weight:bold; margin:0px; padding:0px;">
                    Listado de Cuentas
                </div>
                <div style="border-top: 2px solid #000; margin:0px; padding:0px"/>

                <div class="row" style="margin-top: 1em">
                    <div class="col-8">
                        Empresa: <strong><t t-esc="o.company_name"/></strong>
                    </div>
                    <div class="col-4 text-right">
                        Página: <span class="page"/>
                    </div>
                </div>

                <div class="row">
                    <div class="col-4">
                        Fecha Inicio: <t t-esc="o.date_start.strftime('%d/%m/%Y')"/>
                    </div>
                    <div class="col-4">
                        Fecha Final: <t t-esc="o.date_end.strftime('%d/%m/%Y')"/>
                    </div>
                </div>
                <div style="border-bottom: 1px solid #000; margin-top: 4px;"/>
            </div>

            <t t-raw="0"/>
        </template>

        <!-- TEMPLATE -->
        <template id="partner_ledger_template">
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="docs"/>
                <t t-set="data_report_margin_top" t-value="40"/>
                <t t-set="data_report_header_spacing" t-value="30"/>

                <t t-foreach="partners" t-as="p">
                    <t t-if="not l_first">
                        <p style="page-break-before: always;"/>
                    </t>

                    <t t-call="motsoft_partner_ledger.partner_ledger_header">
                        <div class="page">

                            <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
                                <colgroup>
                                    <col style="width:15%;"/>
                                    <col style="width:40%;"/>
                                    <col style="width:15%;"/>
                                    <col style="width:15%;"/>
                                    <col style="width:15%;"/>
                                </colgroup>
                                <thead>
                                    <!-- Fila 1: nombre de cuenta -->
                                    <tr>
                                        <td colspan="5"
                                            style="background-color:#EEE;
                                                   text-align:left;
                                                   padding-left: 5px;
                                                   margin-top: 1em;
                                                   margin-bottom: 1em;
                                                   border-top: 1px solid #000;
                                                   border-bottom: 1px solid #000;
                                                   font-weight:bold;">
                                            <t t-esc="p['account_code']"/>
                                            <t t-if="p['name']">
                                                - <t t-esc="p['name']"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <!-- Separación -->
                                    <tr><td colspan="5" style="padding-top: 1em"/></tr>
                                    <!-- Fila 2: títulos de columna -->
                                    <tr style="border-bottom: 1px solid #000">
                                        <th style="font-weight:normal; text-align:left;">Fecha</th>
                                        <th style="font-weight:normal; text-align:left;">Referencia</th>
                                        <th style="font-weight:normal; text-align:right;">Debe</th>
                                        <th style="font-weight:normal; text-align:right;">Haber</th>
                                        <th style="font-weight:normal; text-align:right;">Saldo</th>
                                    </tr>
                                    <!-- Separación -->
                                </thead>
                                <tbody>
                                    <t t-foreach="p['lines']" t-as="line">
                                        <tr style="margin: 0px; padding: 0px;">
                                            <td style="text-align:left;">
                                                <t t-if="not line['date']">
                                                    <t t-esc="o.date_start.strftime('%d/%m/%Y')"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="line['date'].strftime('%d/%m/%Y') if line['date'] else ''"/>
                                                </t>
                                            </td>
                                            <td style="text-align:left;">
                                                <t t-esc="line['ref'] if line['ref'] else ''"/>
                                            </td>
                                            <td style="text-align:right;" t-esc="formatLang(env, line['debit'],  digits=2)"/>
                                            <td style="text-align:right;" t-esc="formatLang(env, line['credit'], digits=2)"/>
                                            <td style="text-align:right;" t-esc="formatLang(env, line['balance_acc'], digits=2)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>
                    </t>
                </t>
            </t>
        </template>


        <!-- REPORT ACTION -->
        <record id="partner_ledger_report" model="ir.actions.report">
            <field name="name">Libro Mayor Empresa</field>
            <field name="model">motsoft.partner.ledger</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">motsoft_partner_ledger.partner_ledger_template</field>
            <field name="report_file">motsoft_partner_ledger.partner_ledger_template</field>
            <field name="print_report_name">'Libro_Mayor'</field>
        </record>

    </data>
</odoo>
