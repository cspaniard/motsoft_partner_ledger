<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>

        <template id="partner_ledger_header">
            <div class="header">
                <div class='row' style="font-size:1.5em; font-weight:bold; margin:0px; padding:0px;">
                    Listado de Cuentas
                </div>
                <div style="border-top: 2px solid #000; margin:0px; padding:0px"/>

                <div class="row" style="margin-top: 1em">
                    <div class="col-8">
                        Empresa: <strong><t t-esc="o.company_name"/></strong>
                    </div>
                    <div class="col-4 text-right">
                        Página: <span class="page"/>
                    </div>
                </div>

                <div class="row">
                    <div class="col-4">
                        Fecha Inicio: <t t-esc="o.date_start"/>
                    </div>
                    <div class="col-4">
                        Fecha Final: <t t-esc="o.date_end"/>
                    </div>
                </div>
                <div style="border-bottom: 1px solid #000; margin-top: 4px;"/>
            </div>

            <t t-out="0"/>
        </template>

        <!-- TEMPLATE -->
        <template id="partner_ledger_template">
            <t t-call="web.basic_layout">
                <t t-set="o" t-value="docs"/>
                <t t-set="data_report_margin_top" t-value="40"/>
                <t t-set="data_report_header_spacing" t-value="30"/>

                <t t-foreach="partners" t-as="p">
                    <t t-if="not l_first">
                        <p style="page-break-before: always;"/>
                    </t>

                    <t t-call="motsoft_partner_ledger.partner_ledger_header">
                        <div class="page">
                            <div style="background-color:#EEE; text-align:left;
                                padding-left: 5px;
                                margin-bottom: 1em;
                                border-top: 1px solid #000;
                                border-bottom: 1px solid #000;
                                font-weight:bold;">
                               <t t-esc="p['account_code']"/> - <t t-esc="p['name']"/>
                            </div>
                            <div class="row no-gutters"
                                 style="border-bottom: 1px solid #000; margin: 0px; padding: 0px">
                                <div class="col-2 text-left">Fecha</div>
                                <div class="col-4 text-left">Referencia</div>
                                <div class="col-2 text-right">Debe</div>
                                <div class="col-2 text-right">Haber</div>
                                <div class="col-2 text-right">Saldo</div>
                            </div>

                            <t t-foreach="p['lines']" t-as="line">
                                <div class="row no-gutters" style="margin: 0px; padding: 0px">
                                    <div class="col-2 text-left" t-esc="line['date']"/>
                                    <div class="col-4 text-left" t-esc="line['ref']"/>
                                    <div class="col-2 text-right" t-esc="formatLang(env, line['debit'],  digits=2)"/>
                                    <div class="col-2 text-right" t-esc="formatLang(env, line['credit'], digits=2)"/>
                                    <div class="col-2 text-right" t-esc="formatLang(env, line['balance_acc'], digits=2)"/>
                                </div>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- REPORT ACTION -->
        <record id="partner_ledger_report" model="ir.actions.report">
            <field name="name">Libro Mayor Empresa</field>
            <field name="model">report.motsoft_partner_ledger.partner_ledger_template</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">motsoft_partner_ledger.partner_ledger_template</field>
            <field name="report_file">motsoft_partner_ledger.partner_ledger_template</field>
            <field name="print_report_name">'Libro_Mayor'</field>
        </record>

    </data>
</odoo>
